{
  "apiVersion": "hath0r.observability.otel/v1",
  "kind": "OpenTelemetryConfig",
  "metadata": {
    "name": "poc-otel-defaults",
    "control_tower": "Bayly-AI/HATH0R-CLI",
    "product": "HATH0R-Agentic-POC",
    "updated": "2026-10-31",
    "issue": 105
  },
  "resource": {
    "service_name": "hath0r-poc-ui",
    "service_namespace": "hath0r-opensource",
    "deployment_environment": "local"
  },
  "exporters": {
    "otlp": {
      "protocol": "http/protobuf",
      "endpoint_env": "OTEL_EXPORTER_OTLP_ENDPOINT",
      "headers_env": "OTEL_EXPORTER_OTLP_HEADERS",
      "default_endpoint": "http://localhost:38000/phoenix",
      "container_endpoint": "http://Hath0r-phoenix:6006/v1/traces"
    }
  },
  "network_services": {
    "phoenix": "http://localhost:38000/phoenix",
    "mlflow": "http://localhost:38000/mlflow/",
    "cruise_control": "http://localhost:38000/cruise/radar",
    "mcp": "http://localhost:38000/mcp/"
  },
  "traces": {
    "sampler": "parentbased_traceidratio",
    "sampler_arg": "0.1",
    "enabled": true
  },
  "metrics": {
    "enabled": true,
    "export_interval_ms": 60000
  },
  "policy": {
    "never_commit_secrets": true,
    "credentials_root": "/Users/raybayly/Development/.credentials"
  }
}
