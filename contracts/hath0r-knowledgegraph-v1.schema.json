{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Bayly-AI/HATH0R-Agentic-Framework/development/contracts/hath0r-knowledgegraph-v1.schema.json",
  "title": "Hath0rKnowledgeGraphManifest",
  "description": "Schema definition for static and compiled Hath0r KnowledgeGraph entity nodes and relational edges.",
  "type": "object",
  "required": ["schema_version", "nodes", "edges"],
  "additionalProperties": true,
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["hath0r.knowledgegraph/1", "1.0.0"],
      "description": "Schema version identifier for KnowledgeGraph payloads."
    },
    "graph_id": {
      "type": "string",
      "description": "Optional unique identifier for this KnowledgeGraph snapshot."
    },
    "updated_at": {
      "type": "string",
      "description": "ISO 8601 timestamp of graph snapshot generation."
    },
    "nodes": {
      "type": "array",
      "description": "Entity nodes in the KnowledgeGraph.",
      "items": {
        "type": "object",
        "required": ["id", "type", "title"],
        "additionalProperties": true,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "Unique identifier / URI for the node (e.g. doc path, contract id, tool name)."
          },
          "type": {
            "type": "string",
            "enum": [
              "document",
              "contract",
              "procedure",
              "strategy",
              "playbook",
              "runbook",
              "checklist",
              "policy",
              "tool",
              "bot",
              "subsystem"
            ],
            "description": "Canonical classification type for the node."
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "description": "Human-readable label or title."
          },
          "path": {
            "type": "string",
            "description": "Relative or canonical filesystem path to source file."
          },
          "subsystem": {
            "type": "string",
            "description": "Subsystem folder or domain membership (e.g. docs, contracts, lib, cfg)."
          },
          "properties": {
            "type": "object",
            "description": "Arbitrary key-value metadata extracted from frontmatter."
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "description": "Directed relational edges between KnowledgeGraph nodes.",
      "items": {
        "type": "object",
        "required": ["source", "target", "relation"],
        "additionalProperties": true,
        "properties": {
          "source": {
            "type": "string",
            "description": "Node ID of the origin."
          },
          "target": {
            "type": "string",
            "description": "Node ID of the destination."
          },
          "relation": {
            "type": "string",
            "enum": [
              "depends_on",
              "implements",
              "references",
              "governed_by",
              "validates",
              "contains",
              "routes_to",
              "invokes"
            ],
            "description": "Semantic relationship type."
          },
          "weight": {
            "type": "number",
            "description": "Optional edge weight or confidence score (0.0 to 1.0)."
          },
          "metadata": {
            "type": "object",
            "description": "Additional edge metadata."
          }
        }
      }
    }
  }
}
